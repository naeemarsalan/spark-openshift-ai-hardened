# BASELINE FOR COMPARISON ONLY - do not ship this.
#
# This is the "regular" way a Spark image is usually built on UBI: full UBI base, software
# downloaded from the internet during the build, stock Spark jars left as shipped, pip and the
# package manager left in the image. It provides the same features as the hardened images
# (spark-submit, Spark Connect, Scala + Python, S3A and JDBC drivers) so scans compare like
# with like. See docs/hardening.md for what the hardened build changes and why.
FROM registry.access.redhat.com/ubi9/ubi:9.9

ARG SPARK_VERSION=4.3.0
ARG DNF_REPO_ARGS=""

RUN dnf ${DNF_REPO_ARGS} install -y java-21-openjdk-headless python3.12 python3.12-pip procps-ng tar gzip && \
    dnf clean all

RUN curl -fsSL https://dlcdn.apache.org/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz \
      | tar -xz -C /opt && mv /opt/spark-${SPARK_VERSION}-bin-hadoop3 /opt/spark

RUN cd /opt/spark/jars && M=https://repo1.maven.org/maven2 && \
    curl -fsSLO $M/org/apache/hadoop/hadoop-aws/3.5.0/hadoop-aws-3.5.0.jar && \
    curl -fsSLO $M/software/amazon/awssdk/bundle/2.59.9/bundle-2.59.9.jar && \
    curl -fsSLO $M/org/postgresql/postgresql/42.7.15/postgresql-42.7.15.jar && \
    curl -fsSLO $M/com/microsoft/sqlserver/mssql-jdbc/13.6.2.jre11/mssql-jdbc-13.6.2.jre11.jar && \
    curl -fsSLO $M/com/oracle/database/jdbc/ojdbc17/23.26.4.0.0/ojdbc17-23.26.4.0.0.jar

RUN python3.12 -m pip install --no-cache-dir numpy "pandas<3" pyarrow grpcio grpcio-status zstandard

ENV SPARK_HOME=/opt/spark \
    JAVA_HOME=/usr/lib/jvm/jre-21-openjdk \
    PATH=/opt/spark/bin:/opt/spark/sbin:$PATH \
    PYSPARK_PYTHON=/usr/bin/python3.12

RUN useradd -u 185 -g 0 -d /opt/spark/work-dir spark && mkdir -p /opt/spark/work-dir && \
    chown -R 185:0 /opt/spark && cp /opt/spark/kubernetes/dockerfiles/spark/entrypoint.sh /opt/entrypoint.sh
WORKDIR /opt/spark/work-dir
USER 185
ENTRYPOINT ["/opt/entrypoint.sh"]
