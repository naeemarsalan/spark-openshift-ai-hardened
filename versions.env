# Single source of truth for everything that goes into the image.
# Bump here, run `make fetch` (updates artifacts.sha256), review the diff, commit.

SPARK_VERSION=4.3.0
HADOOP_PROFILE=hadoop3
# Must match the Hadoop version Spark was built against (see $SPARK_HOME/RELEASE).
HADOOP_VERSION=3.5.0
JAVA_MAJOR=21
PYTHON_VERSION=3.12

# Pin by digest in production (skopeo inspect ... | jq -r .Digest).
HI_BUILDER_IMAGE=registry.access.redhat.com/hi/openjdk:21-runtime-builder
UBI9_BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.9

# Final image is $(REGISTRY)/$(IMAGE_NAME)-$(FLAVOR):$(IMAGE_TAG)
IMAGE_NAME=spark
IMAGE_TAG=4.3.0-3
# Registry + project images are tagged for and pushed to (private Harbor project; log in with `podman login`).
REGISTRY=oci.arsalan.io/spark
