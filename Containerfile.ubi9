# Apache Spark for OpenShift AI / OpenShift (restricted-v2 SCC) - UBI 9 base
#
# One image for: spark-submit drivers, Scala/Java + Python executors, Spark Connect server.
#
# Build rules:
#   * Nothing is downloaded from the internet. Third-party binaries are COPYed from
#     ./artifacts (hack/fetch-artifacts.sh) and verified against artifacts.sha256.
#     The only network access is the package manager talking to the configured RPM repo
#     (Red Hat CDN here; Satellite / internal mirror in a regulated build farm).
#   * No secrets, keys or credentials are baked in.
#   * Runs as non-root 1001:0 by default AND as any arbitrary UID in group 0.
#   * Build tooling (package manager, pip, tar) exists only in the builder stage.
#
# Base: Red Hat Universal Base Image 9 (minimal). RHEL 9 lifecycle and errata; expect
# scanners to list RHEL CVEs that Red Hat has assessed but not (yet) fixed.

ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.9

# ------------------------------------------------------------------ builder
FROM ${BASE_IMAGE} AS builder

ARG SPARK_VERSION
ARG HADOOP_PROFILE=hadoop3
ARG PYTHON_VERSION=3.12
# Repo selection for microdnf. Override for Satellite / internal mirrors.
ARG DNF_REPO_ARGS="--disablerepo=* --enablerepo=ubi-9-baseos-rpms --enablerepo=ubi-9-appstream-rpms"

# nss_wrapper is installed here only so its single shared object can be copied to the final
# image without its perl/cmake/pkgconf dependency chain.
RUN microdnf ${DNF_REPO_ARGS} install -y --nodocs --setopt=install_weak_deps=0 \
        tar gzip findutils python${PYTHON_VERSION} nss_wrapper && microdnf clean all

WORKDIR /build
COPY artifacts.sha256 image/requirements.txt image/jars-remove.txt image/assemble.sh ./
COPY artifacts/ ./artifacts/
RUN ./assemble.sh

# -------------------------------------------------------------------- final
FROM ${BASE_IMAGE}

ARG SPARK_VERSION
ARG JAVA_MAJOR=21
ARG PYTHON_VERSION=3.12
ARG IMAGE_VERSION=dev
ARG DNF_REPO_ARGS="--disablerepo=* --enablerepo=ubi-9-baseos-rpms --enablerepo=ubi-9-appstream-rpms"

LABEL name="spark-ubi9" \
      version="${SPARK_VERSION}" \
      release="${IMAGE_VERSION}" \
      summary="Apache Spark ${SPARK_VERSION} (Spark Connect, spark-submit, Scala and Python executors)" \
      description="Hardened Apache Spark runtime for OpenShift AI. Runs under the restricted-v2 SCC as an arbitrary non-root UID." \
      io.k8s.display-name="Apache Spark ${SPARK_VERSION}" \
      io.k8s.description="Hardened Apache Spark runtime for OpenShift AI. Runs under the restricted-v2 SCC as an arbitrary non-root UID." \
      io.openshift.tags="spark,pyspark,spark-connect,openshift-ai" \
      org.opencontainers.image.title="spark-ubi9" \
      org.opencontainers.image.version="${SPARK_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"

# `upgrade` pulls RPM security errata published after the base image was cut.
RUN microdnf ${DNF_REPO_ARGS} upgrade -y --nodocs --setopt=install_weak_deps=0 && \
    microdnf ${DNF_REPO_ARGS} install -y --nodocs --setopt=install_weak_deps=0 \
        java-${JAVA_MAJOR}-openjdk-headless python${PYTHON_VERSION} procps-ng && \
    microdnf clean all && \
    rm -rf /var/cache/yum /var/cache/dnf /var/lib/dnf /var/log/* /tmp/* && \
    # The base ships setuid/setgid helpers (chage, gpasswd, newgrp); nothing here needs them.
    find / -xdev -type f -perm /6000 -exec chmod a-s {} + && \
    echo "spark:x:1001:0:Apache Spark:/opt/spark/work-dir:/sbin/nologin" >> /etc/passwd

COPY --from=builder /opt/spark /opt/spark
COPY --from=builder /opt/pydeps/ /usr/local/
COPY --from=builder /licenses /licenses
# Gives an arbitrary UID a passwd entry without making /etc/passwd writable (see entrypoint.sh).
COPY --from=builder /usr/lib64/libnss_wrapper.so /usr/lib64/libnss_wrapper.so
COPY --chmod=0755 image/entrypoint.sh image/decom.sh /opt/
COPY --chmod=0644 image/spark-defaults.conf image/log4j2.properties /opt/spark/conf/

ENV SPARK_HOME=/opt/spark \
    JAVA_HOME=/usr/lib/jvm/jre-${JAVA_MAJOR}-openjdk \
    PATH=/opt/spark/bin:/opt/spark/sbin:/usr/local/bin:/usr/bin:/bin \
    HOME=/opt/spark/work-dir \
    PYSPARK_PYTHON=/usr/bin/python${PYTHON_VERSION} \
    PYSPARK_DRIVER_PYTHON=/usr/bin/python${PYTHON_VERSION} \
    PYTHONPATH=/opt/spark/python:/opt/spark/python/lib/py4j-src.zip \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SPARK_LOG_DIR=/tmp/spark-logs \
    SPARK_PID_DIR=/tmp/spark-pids \
    LANG=C.UTF-8

# SPARK_LOG_DIR / SPARK_PID_DIR: the OpenShift AI Spark Operator starts Spark Connect with
# sbin/start-connect-server.sh (bypassing the entrypoint); keep its files off the read-only /opt/spark.
WORKDIR /opt/spark/work-dir

# Numeric UID:GID so the kubelet can verify `runAsNonRoot: true`.
USER 1001:0

ENTRYPOINT ["/opt/entrypoint.sh"]
